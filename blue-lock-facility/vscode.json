{
  "name": "Blue Lock Facility",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "parameter": "#65D9FF",
    "parameter.declaration": "#65D9FF",
    "variable": "#F4F8FF",
    "variable.declaration": "#F4F8FF",
    "variable.readonly": "#B7ECFF",
    "property": "#65D9FF",
    "function": "#197DFF",
    "method": "#197DFF",
    "class": "#8FD6FF",
    "interface": "#8FD6FF",
    "enum": "#8FD6FF",
    "enumMember": "#7CCBFF",
    "type": "#8FD6FF",
    "namespace": "#197DFF",
    "macro": "#65D9FF",
    "decorator": "#197DFF",
    "string": "#35D07F",
    "number": "#7CCBFF",
    "boolean": "#7CCBFF",
    "regexp": "#A6EEFF",
    "operator": "#4AA3FF",
    "keyword": "#B4E4FF",
    "comment": {
      "foreground": "#9AB5D6",
      "fontStyle": "italic"
    }
  },
