{
  "name": "Blue Lock Facility — Egoist Edition",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "parameter": "#00E5FF",
    "parameter.declaration": "#00E5FF",
    "variable": "#E6F0FF",
    "variable.declaration": "#E6F0FF",
    "variable.readonly": "#6BEEFF",
    "property": "#00E5FF",
    "function": "#0066FF",
    "method": "#3388FF",
    "class": "#7B61FF",
    "interface": "#7B61FF",
    "enum": "#A48EFF",
    "enumMember": "#00E5FF",
    "type": "#6BEEFF",
    "namespace": "#0066FF",
    "macro": "#FFCC00",
    "decorator": "#FFCC00",
    "string": "#00E676",
    "number": "#A48EFF",
    "boolean": "#FFCC00",
    "regexp": "#6BEEFF",
    "operator": "#3388FF",
    "keyword": "#3388FF",
    "comment": {
      "foreground": "#7AA0C8",
      "fontStyle": "italic"
    }
  },
  "colors": {
    "foreground": "#E6F0FF",
    "disabledForeground": "#7AA0C8",
    "focusBorder": "#0066FF88",
    "widget.shadow": "#00030A99",
    "selection.background": "#0A2A6B99",
    "descriptionForeground": "#7AA0C8",
    "errorForeground": "#FF3B30",
    "icon.foreground": "#E6F0FF",
    "sash.hoverBorder": "#00E5FF",
    "textBlockQuote.background": "#010514",
    "textBlockQuote.border": "#0066FF",
    "textCodeBlock.background": "#010514",
    "textLink.activeForeground": "#6BEEFF",
    "textLink.foreground": "#00E5FF",
    "textPreformat.foreground": "#00E5FF",
    "textPreformat.background": "#010514",
    "textSeparator.foreground": "#0F2A4A",
    "button.background": "#0066FF",
    "button.foreground": "#E6F0FF",
    "button.hoverBackground": "#3388FF",
    "button.secondaryForeground": "#E6F0FF",
    "button.secondaryBackground": "#0A1E3D",
    "button.secondaryHoverBackground": "#0A2A6B",
    "button.border": "#0066FF22",
    "checkbox.background": "#010514",
    "checkbox.foreground": "#E6F0FF",
    "checkbox.border": "#0F2A4A",
    "checkbox.selectBackground": "#0066FF",
    "checkbox.selectBorder": "#0066FF",
    "dropdown.background": "#010514",
    "dropdown.listBackground": "#010514",
    "dropdown.border": "#0F2A4A",
    "dropdown.foreground": "#E6F0FF",
    "input.background": "#010514",
    "input.border": "#0F2A4A",
    "input.foreground": "#E6F0FF",
    "input.placeholderForeground": "#7AA0C8",
    "inputOption.activeBackground": "#0066FF44",
    "inputOption.activeBorder": "#0066FF",
    "inputOption.activeForeground": "#E6F0FF",
    "inputOption.hoverBackground": "#0A2A6B",
    "scrollbar.shadow": "#00030A",
    "scrollbarSlider.activeBackground": "#0066FF88",
    "scrollbarSlider.background": "#0F2A4A66",
    "scrollbarSlider.hoverBackground": "#00E5FF88",
    "badge.background": "#00E5FF",
    "badge.foreground": "#010A1E",
    "progressBar.background": "#0066FF",
    "list.activeSelectionBackground": "#0066FF30",
    "list.activeSelectionForeground": "#E6F0FF",
    "list.activeSelectionIconForeground": "#00E5FF",
    "list.dropBackground": "#0066FF22",
    "list.focusBackground": "#0066FF22",
    "list.focusForeground": "#E6F0FF",
    "list.focusOutline": "#0066FF66",
    "list.highlightForeground": "#00E5FF",
    "list.hoverBackground": "#0A1E3D",
    "list.hoverForeground": "#E6F0FF",
    "list.inactiveSelectionBackground": "#0F2A4A66",
    "list.inactiveSelectionForeground": "#E6F0FF",
    "list.inactiveFocusBackground": "#0F2A4A66",
    "list.inactiveFocusOutline": "#0F2A4A",
    "list.invalidItemForeground": "#FF3B30",
    "list.errorForeground": "#FF3B30",
    "list.warningForeground": "#FFCC00",
    "listFilterWidget.background": "#010514",
    "listFilterWidget.outline": "#0066FF",
    "listFilterWidget.noMatchesOutline": "#FF3B30",
    "tree.indentGuidesStroke": "#0F2A4A",
    "activityBar.background": "#010514",
    "activityBar.foreground": "#E6F0FF",
    "activityBar.inactiveForeground": "#7AA0C8",
    "activityBarBadge.background": "#00E5FF",
    "activityBarBadge.foreground": "#010A1E",
    "activityBar.activeBorder": "#00E5FF",
    "sideBar.background": "#010514",
    "sideBar.foreground": "#E6F0FF",
    "sideBar.border": "#0A1E3D",
    "sideBarTitle.foreground": "#E6F0FF",
    "sideBarSectionHeader.background": "#010A1E",
    "sideBarSectionHeader.foreground": "#7AA0C8",
    "editor.background": "#010A1E",
    "editor.foreground": "#E6F0FF",
    "editorLineNumber.foreground": "#0F2A4A",
    "editorLineNumber.activeForeground": "#E6F0FF",
    "editorCursor.foreground": "#00E5FF",
    "editor.selectionBackground": "#0A2A6B77",
    "editor.selectionForeground": "#E6F0FF",
    "editor.inactiveSelectionBackground": "#0A2A6B44",
    "editor.selectionHighlightBackground": "#0066FF22",
    "editor.selectionHighlightBorder": "#0066FF44",
    "editor.wordHighlightBackground": "#0066FF22",
    "editor.wordHighlightBorder": "#0066FF44",
    "editor.wordHighlightStrongBackground": "#0066FF33",
    "editor.lineHighlightBackground": "#0A1E3D",
    "editorIndentGuide.background1": "#0F2A4A",
    "editorIndentGuide.activeBackground1": "#0066FF",
    "editorWhitespace.foreground": "#0F2A4A",
    "editorWidget.background": "#010514",
    "editorWidget.border": "#0066FF",
    "editorSuggestWidget.background": "#010514",
    "editorSuggestWidget.border": "#0066FF",
    "editorHoverWidget.background": "#010514",
    "editorHoverWidget.border": "#00E5FF",
    "terminal.background": "#010A1E",
    "terminal.foreground": "#E6F0FF",
    "terminal.ansiBlack": "#010514",
    "terminal.ansiBlue": "#0066FF",
    "terminal.ansiCyan": "#00E5FF",
    "terminal.ansiGreen": "#00E676",
    "terminal.ansiMagenta": "#7B61FF",
    "terminal.ansiRed": "#FF3B30",
    "terminal.ansiYellow": "#FFCC00",
    "terminal.ansiBrightBlack": "#0F2A4A",
    "terminal.ansiBrightBlue": "#3388FF",
    "terminal.ansiBrightCyan": "#6BEEFF",
    "terminal.ansiBrightGreen": "#69FF9E",
    "terminal.ansiBrightMagenta": "#A48EFF",
    "terminal.ansiBrightRed": "#FF6B60",
    "terminal.ansiBrightYellow": "#FFE566",
    "terminal.ansiWhite": "#E6F0FF",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "statusBar.background": "#010514",
    "statusBar.foreground": "#7AA0C8",
    "statusBar.border": "#0A1E3D",
    "statusBar.debuggingBackground": "#FF3B30",
    "statusBar.debuggingForeground": "#FFFFFF",
    "titleBar.activeBackground": "#010514",
    "titleBar.activeForeground": "#E6F0FF",
    "titleBar.inactiveBackground": "#00030A",
    "titleBar.inactiveForeground": "#7AA0C8",
    "tab.activeBackground": "#010A1E",
    "tab.activeForeground": "#E6F0FF",
    "tab.activeBorderTop": "#00E5FF",
    "tab.inactiveBackground": "#010514",
    "tab.inactiveForeground": "#7AA0C8",
    "tab.border": "#0A1E3D",
    "panel.background": "#010514",
    "panel.border": "#0A1E3D"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7AA0C8", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#3388FF", "fontStyle": "bold" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#00E676" }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": { "foreground": "#A48EFF" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#00E5FF" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class"],
      "settings": { "foreground": "#FFCC00" }
    }
  ]
}
