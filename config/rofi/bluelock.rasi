configuration {
  modi: "drun,run,window";
  show-icons: true;
  drun-display-format: "{name}";
}

* {
  bg0: rgba(1, 10, 30, 0.78);
  bg1: rgba(10, 30, 61, 0.92);
  bg2: rgba(0, 102, 255, 0.20);
  bg3: rgba(0, 102, 255, 0.38);
  fg0: #E6F0FF;
  fg1: #7AA0C8;
  accent: #0066FF;
  accent2: #00E5FF;
  ego: #FFCC00;
  urgent: #FF3B30;
  font: "Space Grotesk 12";
}

window {
  location: center;
  anchor: center;
  width: 38%;
  transparency: "real";
  background-color: @bg0;
  border: 2px;
  border-color: @accent;
  border-radius: 22px;
  padding: 18px;
}

mainbox {
  spacing: 14px;
  children: [ "inputbar", "listview" ];
}

inputbar {
  background-color: @bg1;
  border: 1px solid @bg3;
  border-radius: 16px;
  padding: 14px 16px;
  spacing: 12px;
}

prompt {
  text-color: @accent2;
  font: "Space Grotesk Bold 12";
}

entry {
  text-color: @fg0;
  placeholder-color: @fg1;
  placeholder: "ARE YOU AN EGOIST?";
  background-color: transparent;
  cursor-color: @accent2;
}

listview {
  background-color: transparent;
  spacing: 8px;
  scrollbar: false;
}

element {
  background-color: @bg1;
  border: 1px solid transparent;
  border-radius: 14px;
  padding: 12px 14px;
  spacing: 12px;
}

element normal {
  background-color: @bg1;
}

element selected {
  background-color: @bg2;
  border: 1px solid @accent;
  text-color: @fg0;
}

element urgent {
  background-color: alpha(@ego, 0.14);
  border: 1px solid @ego;
}

element-icon {
  size: 24px;
}

element-text {
  text-color: @fg0;
}

message {
  background-color: @bg1;
  border-radius: 14px;
  padding: 12px;
}
